#!/usr/bin/env bash
# Mandatory: refuse to push an unsanitized public tree.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if command -v python3 >/dev/null 2>&1; then
  PY=(python3)
elif command -v python >/dev/null 2>&1; then
  PY=(python)
elif command -v py >/dev/null 2>&1; then
  PY=(py -3)
else
  echo "pre-push: Python 3 is required for the sanitization check" >&2
  exit 1
fi

"${PY[@]}" scripts/check_public_tree.py
